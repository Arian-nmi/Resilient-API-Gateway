# ──────────────────────────────────────────────────────────────
# Template — copy to .env and fill in real values. .env is gitignored.
# docker compose reads .env automatically for ${VAR} interpolation, and the
# FastAPI app reads it via python-decouple (app/config.py).
# ──────────────────────────────────────────────────────────────
# PostgreSQL credentials (sensitive — set real values here)
POSTGRES_USER=gateway
POSTGRES_PASSWORD=gateway
POSTGRES_DB=gateway
# Gateway upstream providers
GW_PROVIDER_A_URL=http://92.114.51.251:8001/v1/process
GW_PROVIDER_B_URL=http://92.114.51.251:8002/v1/process
GW_PROVIDER_C_URL=http://92.114.51.251:8003/v1/process
# Audit writer on/off
GW_WRITER_ENABLED=true
# ── Optional overrides (local dev; docker-compose sets internal hostnames) ──
GW_REDIS_URL=redis://localhost:6379/0
GW_DATABASE_URL=postgresql://gateway:gateway@localhost:5432/gateway
# ── Provider A: fast but strictly rate limited ──
GW_A_RATE=40
GW_A_BURST=60
GW_A_TIMEOUT=3
GW_A_MAX_CONCURRENCY=100
# ── Providers B/C: slow (~10s), flaky (~10% errors) ──
GW_BC_TIMEOUT=11
GW_BC_MAX_CONCURRENCY=500
# ── Retry / failover ──
GW_MAX_ATTEMPTS=3
GW_BACKOFF_BASE=0.1
GW_REQUEST_DEADLINE=25
# ── Protecting our own service ──
GW_INGRESS_RATE=5000
GW_INGRESS_BURST=5000
GW_MAX_IN_FLIGHT=2000
# ── Circuit breaker (per provider, per instance) ──
GW_BREAKER_WINDOW=20
GW_BREAKER_MIN_CALLS=10
GW_BREAKER_THRESHOLD=0.5
GW_BREAKER_OPEN_SECONDS=10
# ── Redis / Postgres tuning ──
GW_REDIS_TIMEOUT=0.5
GW_REDIS_RETRY_AFTER_FAILURE=5
GW_WRITER_QUEUE_SIZE=50000
GW_WRITER_BATCH_SIZE=1000
GW_WRITER_FLUSH_INTERVAL=0.5
GW_LOG_LEVEL=INFO